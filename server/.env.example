# Copy this file to server/.env and fill in your real Neon connection string.
# In the Neon console: your project -> Connect -> copy the "psql" / pooled
# connection string (it already includes sslmode=require).
DATABASE_URL=postgresql://user:password@ep-xxxx.aws.neon.tech/neondb?sslmode=require

# Needed for the AI Agent (sparkle icon, with web search); also enables full AI answers in the robot chat.
# ANTHROPIC_API_KEY=sk-ant-...
# CHAT_MODEL=claude-sonnet-5-5

# Machine-to-machine API (/api/service/*). Keys now live in the database as "service accounts" —
# create one per calling system:   npm run service-account -- create erp --events addition,adjustment
# (see SERVICE-API.md). The variable below is OPTIONAL and kept for simple setups / tests:
# one "name:key" pair per system, comma separated; these keys may post every event type.
# SERVICE_API_KEYS=erp:<paste-long-random-key>
# SERVICE_MAX_ROWS=500
# SERVICE_BODY_LIMIT=10mb

# SAP integration (Integrations -> SAP). Leave SAP_BASE_URL empty to use the built-in MOCK data.
# SAP_BASE_URL=https://sap.example.com/api
# SAP_ASSETS_PATH=/assets
# SAP_API_TOKEN=<bearer token>
# SAP_DEFAULT_BOOK=GAAP
